{
  "name": "cuestage",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "CueStage — control de música y efectos de sonido para presentaciones en vivo",
  "author": "CueStage",
  "license": "MIT",
  "scripts": {
    "setup": "node scripts/check-setup.mjs",
    "dev": "vite",
    "dev:tauri": "tauri dev",
    "build": "node scripts/make-installer-template.mjs && tauri build",
    "build:frontend": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:fixtures": "node scripts/make-test-audio.mjs",
    "tauri": "tauri",
    "icon": "node scripts/generate-icon.mjs && tauri icon src-tauri/icons/source-icon.png",
    "installer:assets": "node scripts/make-installer-assets.mjs",
    "portable": "node scripts/check-setup.mjs --warn && node scripts/make-portable.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build:frontend"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.3",
    "@tauri-apps/plugin-opener": "2.7.2",
    "lucide-react": "1.60.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.12.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
